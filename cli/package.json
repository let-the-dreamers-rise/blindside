{
  "name": "@blindside/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "stack:up": "docker compose -f standalone.yml up -d",
    "stack:down": "docker compose -f standalone.yml down",
