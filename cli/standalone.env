# Dev defaults for the local indexer container. Local use only; nothing here is a real secret.
APP__INFRA__NODE__URL=ws://node:9944
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer
APP__INFRA__SECRET=303132333435363738393031323334353637383930313233343536373839303132
# Indexer 4.3.3 requires these to exist even on a standalone chain with no separate SPO node.
# The URL must be ws or wss: an http one makes the spo-indexer task exit, which takes the whole
# indexer down about two minutes after start. Pointing it at our own node keeps it quiet.
APP__INFRA__SPO_NODE__BLOCKFROST_ID=standalone
APP__INFRA__SPO_NODE__URL=ws://node:9944
