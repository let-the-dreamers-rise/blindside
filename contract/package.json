{
  "name": "@blindside/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./managed": "./src/managed/blindside/contract/index.js"
  },
  "scripts": {
    "compact": "compact compile src/blindside.compact src/managed/blindside",
