    "test:compile": "pnpm compact && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@noble/hashes": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.0",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
