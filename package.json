    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
      "@midnight-ntwrk/ledger-v8": "8.1.2"
    }
  }
}
